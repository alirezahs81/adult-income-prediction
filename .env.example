# Adult Income Prediction - Environment Variables
# Copy this file to .env and modify as needed
# cp .env.example .env

# Application
APP_NAME=Adult Income Prediction API
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Model
MODEL_PATH=models/best_model.pkl
PREPROCESSOR_PATH=models/preprocessor.pkl
LABEL_ENCODER_PATH=models/label_encoder.pkl

# Data
DATA_DIR=data
PROCESSED_DATA_DIR=data/processed

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json, text

# API
API_TITLE=Adult Income Prediction API
API_DESCRIPTION=Predict whether income exceeds $50K/year based on census data
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Rate Limiting (optional)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# CORS
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Monitoring (optional)
ENABLE_METRICS=false
METRICS_PORT=9090

# Docker
DOCKER_IMAGE=ghcr.io/alirezahs81/adult-income-prediction
DOCKER_TAG=latest